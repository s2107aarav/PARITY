  "paths": {
    "/checkout": {
      "post": {
        "summary": "Checkout",
        "description": "Atomic checkout. Same key/body returns same order; different body is 409.\nAmount uses minor units; tokens ok/declined. Rejected attempts have no business effects.",
        "operationId": "checkout",
        "parameters": [
          {
            "name": "idempotency-key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120,
              "title": "Idempotency-Key"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Checkout"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LegacyOrder"
                }
              }
            }
          },
          "422": {
            "description": "Business error; see notes.md for operation-specific codes",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
