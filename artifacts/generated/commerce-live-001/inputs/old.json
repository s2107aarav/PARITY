  "components": {
    "schemas": {
      "Checkout": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/Item"
            },
            "type": "array",
            "maxItems": 20,
            "minItems": 1,
            "title": "Items"
          },
          "amount": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Amount"
          },
          "payment_token": {
            "type": "string",
            "title": "Payment Token"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "items",
          "amount",
          "payment_token"
        ],
        "title": "Checkout"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
