{
  "openapi": "3.1.0",
  "info": {
    "title": "Moderated issues V3",
    "version": "3.0.0"
  },
  "paths": {
    "/issues": {
      "post": {
        "summary": "Create",
        "description": "Creates unpublished UUID issue. Same key and summary is idempotent, conflicting key is KEY_CONFLICT.",
        "operationId": "create_issue",
        "parameters": [
          {
            "name": "idempotency-key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160,
              "title": "Idempotency-Key"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Issue"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/issues/{issue_ref}/comments": {
      "post": {
        "summary": "Comment",
        "description": "Exactly one initial description comment. Repeating same text is safe; different text is 409 KEY_CONFLICT.",
        "operationId": "add_initial_comment",
        "parameters": [
          {
            "name": "issue_ref",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Issue Ref"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Comment"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/issues/{issue_ref}": {
      "get": {
        "summary": "Get",
        "operationId": "get_issue",
        "parameters": [
          {
            "name": "issue_ref",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Issue Ref"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/issues/{issue_ref}/approve": {
      "post": {
        "summary": "Approve",
        "description": "Requires initial comment. Idempotently returns a stable approval receipt.\nA 503 may occur AFTER the receipt commits; retry this endpoint to reconcile.",
        "operationId": "approve_issue",
        "parameters": [
          {
            "name": "issue_ref",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Issue Ref"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/issues/{issue_ref}/publish": {
      "post": {
        "summary": "Publish",
        "description": "Requires the exact receipt returned by approve. Idempotently publishes.",
        "operationId": "publish_approved_issue",
        "parameters": [
          {
            "name": "issue_ref",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Issue Ref"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Approval"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Approval": {
        "properties": {
          "receipt": {
            "type": "string",
            "title": "Receipt"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "receipt"
        ],
        "title": "Approval"
      },
      "Comment": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Text"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "text"
        ],
        "title": "Comment"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Issue": {
        "properties": {
          "summary": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Summary"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "summary"
        ],
        "title": "Issue"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  },
  "x-parity-domain": "moderated"
}
